# Copy this file to .env and fill in real values. Do NOT commit .env.
# .env is already listed in .gitignore.

# OpenAI API key used by src/code_generator.py and src/problem_extractor.py.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# OpenAI model used for both extraction and DSL generation.
OPENAI_MODEL=gpt-5.4-2026-03-05

# Sampling temperature for the LLM calls (lower = more deterministic).
OPENAI_TEMPERATURE=0.1

# Maximum number of self-correction iterations in the LangGraph loop.
MAX_ITERATIONS=5

# Optional: absolute path to the sibling TFMClassTester project.
# Leave empty to skip the auto-copy of generated .java files.
# TESTER_SRC_DIR=C:/git/UOC/Research/TFMClassTester/src
