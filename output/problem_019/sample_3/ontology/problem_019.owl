<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/program"
         xmlns="http://example.org/program#"
         xmlns:phys="http://example.org/physics#">

<owl:Ontology rdf:about="http://example.org/program"/>

<owl:NamedIndividual rdf:about="#phys_seconds_per_hour">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#DimensionlessQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Second"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3600.0</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#phys_P">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#PowerQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Watt"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3000.0</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#phys_N_days">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#DimensionlessQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Hour"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">30.0</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_2_energy">
  <rdf:type rdf:resource="http://example.org/physics#MultiplicationExpression"/>
  <phys:hasLeftOperand rdf:resource="#phys_P"/>
  <phys:hasRightOperand rdf:resource="#Res_time_s_1"/>
  <phys:hasResultMeasurement rdf:resource="#Res_energy_2"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_energy_2">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#phys_t_day">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#TimeQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Hour"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8.0</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_1_time_s">
  <rdf:type rdf:resource="http://example.org/physics#MultiplicationExpression"/>
  <phys:hasLeftOperand rdf:resource="#phys_t_day"/>
  <phys:hasRightOperand rdf:resource="#phys_seconds_per_hour"/>
  <phys:hasResultMeasurement rdf:resource="#Res_time_s_1"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_time_s_1">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_3_total_energy">
  <rdf:type rdf:resource="http://example.org/physics#MultiplicationExpression"/>
  <phys:hasLeftOperand rdf:resource="#Res_energy_2"/>
  <phys:hasRightOperand rdf:resource="#phys_N_days"/>
  <phys:hasResultMeasurement rdf:resource="#Res_total_energy_3"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_total_energy_3">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>


</rdf:RDF>
