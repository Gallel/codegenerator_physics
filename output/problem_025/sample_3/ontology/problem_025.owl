<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/program"
         xmlns="http://example.org/program#"
         xmlns:phys="http://example.org/physics#">

<owl:Ontology rdf:about="http://example.org/program"/>

<owl:NamedIndividual rdf:about="#phys_m">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#MassQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Kilogram"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.08</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#phys_v_f">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#VelocityQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Meter"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.6</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_1_delta_v">
  <rdf:type rdf:resource="http://example.org/physics#SubtractionExpression"/>
  <phys:hasLeftOperand rdf:resource="#phys_v_f"/>
  <phys:hasRightOperand rdf:resource="#phys_v_i"/>
  <phys:hasResultMeasurement rdf:resource="#Res_delta_v_1"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_delta_v_1">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#phys_v_i">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#VelocityQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Meter"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#phys_delta_t">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#TimeQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Second"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.16</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_2_a_avg">
  <rdf:type rdf:resource="http://example.org/physics#DivisionExpression"/>
  <phys:hasLeftOperand rdf:resource="#Res_delta_v_1"/>
  <phys:hasRightOperand rdf:resource="#phys_delta_t"/>
  <phys:hasResultMeasurement rdf:resource="#Res_a_avg_2"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_a_avg_2">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_3_F_avg">
  <rdf:type rdf:resource="http://example.org/physics#MultiplicationExpression"/>
  <phys:hasLeftOperand rdf:resource="#phys_m"/>
  <phys:hasRightOperand rdf:resource="#Res_a_avg_2"/>
  <phys:hasResultMeasurement rdf:resource="#Res_F_avg_3"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_F_avg_3">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>


</rdf:RDF>
