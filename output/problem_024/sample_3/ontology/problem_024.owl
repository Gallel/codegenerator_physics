  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Kilogram"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">50.0</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#phys_m_ball">
