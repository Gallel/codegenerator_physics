  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">21.5</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_8_combined_mass">
  <rdf:type rdf:resource="http://example.org/physics#AdditionExpression"/>
  <phys:hasLeftOperand rdf:resource="#phys_m_zipi"/>
  <phys:hasRightOperand rdf:resource="#phys_m_ball"/>
  <phys:hasResultMeasurement rdf:resource="#Res_combined_mass_8"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_combined_mass_8">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#phys_v_ball_relative_ice_return_speed">
