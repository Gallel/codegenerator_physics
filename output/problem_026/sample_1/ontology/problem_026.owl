<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/program"
         xmlns="http://example.org/program#"
         xmlns:phys="http://example.org/physics#">

<owl:Ontology rdf:about="http://example.org/program"/>

<owl:NamedIndividual rdf:about="#phys_m_g">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#MassQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Gram"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">450.0</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_1_rho">
  <rdf:type rdf:resource="http://example.org/physics#DivisionExpression"/>
  <phys:hasLeftOperand rdf:resource="#phys_m_g"/>
  <phys:hasRightOperand rdf:resource="#phys_V_cm3_as_mL"/>
  <phys:hasResultMeasurement rdf:resource="#Res_rho_1"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_rho_1">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#phys_V_cm3_as_mL">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#VolumeQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Liter"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">120.0</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#phys_V_cm3">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#VolumeQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#CubicMeter"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">120.0</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#phys_grams_per_kilogram">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#DimensionlessQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Second"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1000.0</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#phys_cm3_to_m3">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#DimensionlessQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Second"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1e-06</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_2_m_kg">
  <rdf:type rdf:resource="http://example.org/physics#DivisionExpression"/>
  <phys:hasLeftOperand rdf:resource="#phys_m_g"/>
  <phys:hasRightOperand rdf:resource="#phys_grams_per_kilogram"/>
  <phys:hasResultMeasurement rdf:resource="#Res_m_kg_2"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_m_kg_2">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_3_V_m3">
  <rdf:type rdf:resource="http://example.org/physics#MultiplicationExpression"/>
  <phys:hasLeftOperand rdf:resource="#phys_V_cm3"/>
  <phys:hasRightOperand rdf:resource="#phys_cm3_to_m3"/>
  <phys:hasResultMeasurement rdf:resource="#Res_V_m3_3"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_V_m3_3">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_4_rho">
  <rdf:type rdf:resource="http://example.org/physics#DivisionExpression"/>
  <phys:hasLeftOperand rdf:resource="#Res_m_kg_2"/>
  <phys:hasRightOperand rdf:resource="#Res_V_m3_3"/>
  <phys:hasResultMeasurement rdf:resource="#Res_rho_4"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_rho_4">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>


</rdf:RDF>
