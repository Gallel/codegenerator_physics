<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/program"
         xmlns="http://example.org/program#"
         xmlns:phys="http://example.org/physics#">

<owl:Ontology rdf:about="http://example.org/program"/>

<owl:NamedIndividual rdf:about="#phys_two">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#DimensionlessQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Second"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#phys_R">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#LengthQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Meter"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#phys_omega">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#AngularVelocityQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Radian"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5707963267948966</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#phys_two_pi">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#AngleQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Radian"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">6.283185307179586</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_1_v">
  <rdf:type rdf:resource="http://example.org/physics#MultiplicationExpression"/>
  <phys:hasLeftOperand rdf:resource="#phys_omega"/>
  <phys:hasRightOperand rdf:resource="#phys_R"/>
  <phys:hasResultMeasurement rdf:resource="#Res_v_1"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_v_1">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_2_omega_sq">
  <rdf:type rdf:resource="http://example.org/physics#PowerExpression"/>
  <phys:hasLeftOperand rdf:resource="#phys_omega"/>
  <phys:hasRightOperand rdf:resource="#phys_two"/>
  <phys:hasResultMeasurement rdf:resource="#Res_omega_sq_2"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_omega_sq_2">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_3_a_c">
  <rdf:type rdf:resource="http://example.org/physics#MultiplicationExpression"/>
  <phys:hasLeftOperand rdf:resource="#Res_omega_sq_2"/>
  <phys:hasRightOperand rdf:resource="#phys_R"/>
  <phys:hasResultMeasurement rdf:resource="#Res_a_c_3"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_a_c_3">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_4_T">
  <rdf:type rdf:resource="http://example.org/physics#DivisionExpression"/>
  <phys:hasLeftOperand rdf:resource="#phys_two_pi"/>
  <phys:hasRightOperand rdf:resource="#phys_omega"/>
  <phys:hasResultMeasurement rdf:resource="#Res_T_4"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_T_4">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>


</rdf:RDF>
