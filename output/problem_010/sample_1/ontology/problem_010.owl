<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/program"
         xmlns="http://example.org/program#"
         xmlns:phys="http://example.org/physics#">

<owl:Ontology rdf:about="http://example.org/program"/>

<owl:NamedIndividual rdf:about="#phys_two">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#DimensionlessQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Meter"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#phys_v_0">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#VelocityQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Meter"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">25.0</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#phys_t">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#TimeQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Second"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#phys_v_f">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
  <phys:hasQuantityType rdf:resource="http://example.org/physics/physics-domain#VelocityQuantity"/>
  <phys:hasUnit rdf:resource="http://example.org/physics/physics-domain#Meter"/>
  <phys:hasNumericValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</phys:hasNumericValue>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_1_delta_v">
  <rdf:type rdf:resource="http://example.org/physics#SubtractionExpression"/>
  <phys:hasLeftOperand rdf:resource="#phys_v_f"/>
  <phys:hasRightOperand rdf:resource="#phys_v_0"/>
  <phys:hasResultMeasurement rdf:resource="#Res_delta_v_1"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_delta_v_1">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_2_a">
  <rdf:type rdf:resource="http://example.org/physics#DivisionExpression"/>
  <phys:hasLeftOperand rdf:resource="#Res_delta_v_1"/>
  <phys:hasRightOperand rdf:resource="#phys_t"/>
  <phys:hasResultMeasurement rdf:resource="#Res_a_2"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_a_2">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_4_v_avg">
  <rdf:type rdf:resource="http://example.org/physics#DivisionExpression"/>
  <phys:hasLeftOperand rdf:resource="#Res_velocity_sum_3"/>
  <phys:hasRightOperand rdf:resource="#phys_two"/>
  <phys:hasResultMeasurement rdf:resource="#Res_v_avg_4"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_v_avg_4">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_3_velocity_sum">
  <rdf:type rdf:resource="http://example.org/physics#AdditionExpression"/>
  <phys:hasLeftOperand rdf:resource="#phys_v_0"/>
  <phys:hasRightOperand rdf:resource="#phys_v_f"/>
  <phys:hasResultMeasurement rdf:resource="#Res_velocity_sum_3"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_velocity_sum_3">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Op_5_distance">
  <rdf:type rdf:resource="http://example.org/physics#MultiplicationExpression"/>
  <phys:hasLeftOperand rdf:resource="#Res_v_avg_4"/>
  <phys:hasRightOperand rdf:resource="#phys_t"/>
  <phys:hasResultMeasurement rdf:resource="#Res_distance_5"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Res_distance_5">
  <rdf:type rdf:resource="http://example.org/physics#Measurement"/>
</owl:NamedIndividual>


</rdf:RDF>
